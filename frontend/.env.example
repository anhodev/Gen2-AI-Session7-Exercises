# Copy thành .env.local nếu cần đổi. API key KHÔNG đặt ở đây (chỉ nằm ở backend/.env).

# Địa chỉ FastAPI mà route proxy /api/... chuyển request tới (chạy phía server Next.js).
BACKEND_INTERNAL_URL=http://localhost:8000

# Để trống để trình duyệt gọi qua proxy /api cùng origin (khuyến nghị, không cần CORS).
NEXT_PUBLIC_API_URL=
