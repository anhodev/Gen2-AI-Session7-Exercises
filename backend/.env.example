# Copy file này thành .env rồi điền giá trị thật. Không commit .env.

# Để trống hoặc MOCK_LLM=true thì app dùng model giả lập, không tốn tiền gọi model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_LLM=true

# Số vòng tối đa model được gọi tool cho một câu hỏi
MAX_TOOL_ROUNDS=6

# Frontend được phép gọi API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Múi giờ của app (mặc định GMT+7)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Supabase PostgreSQL: Project Settings > Database > Connection parameters.
# Để trống DB_HOST thì app dùng SQLite local (data/app.db).
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_DATABASE=postgres
DB_SSLMODE=require
